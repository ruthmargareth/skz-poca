generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model card {
  id            String   @id @default(uuid())
  name          String
  era           String
  title         String
  type          String
  imageUrlFront String
  imageUrlBack  String
  createdAt     DateTime @default(now())

  @@map("card")
}

model user {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}
